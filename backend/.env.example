# Environment Configuration for Confucius Lecture Summarizer
# ===========================================================
# Copy this file to .env and fill in your actual API keys
# Command: cp .env.example .env

# ElevenLabs API Key
# Get yours at: https://elevenlabs.io/
# Required permissions: text_to_speech
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Google Gemini API Key  
# Get yours at: https://makersuite.google.com/app/apikey
# Required for AI slide generation
GEMINI_API_KEY=your_gemini_api_key_here

# ===========================================================
# NOTES:
# - Never commit the actual .env file to version control
# - Keep your API keys secret and secure
# - Both APIs have free tiers available
# ===========================================================

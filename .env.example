# =============================================================================
# Confucius Lecture Summarizer - Environment Variables
# =============================================================================
#
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Replace the placeholder values with your actual API keys
# 3. Never commit the .env file to version control (it's in .gitignore)
#
# =============================================================================

# ElevenLabs API Key (Required)
# Get your API key from: https://elevenlabs.io/
# Used for: Text-to-Speech narration generation
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Google Gemini API Key (Required)
# Get your API key from: https://makersuite.google.com/app/apikey
# Used for: AI-powered slide content generation
GEMINI_API_KEY=your-gemini-api-key-here

# =============================================================================
# NOTES:
# - Both API keys are required for the pipeline to work
# - Keep your .env file secure and never share it publicly
# - API keys should be kept secret to prevent unauthorized usage
# =============================================================================
